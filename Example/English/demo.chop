[General]
Chord=20
ChordLang=0
ChordMinor=-
Content={cover_title:Demo example*}\n{cover_subtitle:* In english language}\n\n{title:Hello mister Bean}\n{subtitle:  Gilles Maire}\n{subtitle: Virtual disk}\n{composer:Gilles Maire}\n{artist:Gilles Maire}\n{lyricist:Gilles Maire}\n{year:2020}\n{columns:2 }\n{tempo:144}\n{time:4/4}}\n\n[Cx2]Hello mister Bean\n[Gx2][How long have you been\n[Cx2]In my memory\n[Gx2]Do you know my trouble \n[Fx2]All my life was hobble\n[G]I was so sa[C]dy \n{start_of_refrain}\n[C]I love you \n[G]Mister Bean\n[F]I love you \n[G]Mister [C] Bean \n{end_of_refrain}\n\nFor you Mister Bean\nI would have peeled beans\nWith a knife\nI would have combed my hair\nI would have dreamed in my chair\nAll my life\n\nBut today Monsieur Beans\nI hadn't planned\nTo be at your funeral\nI had a thousand things to do\nI wanted to go to the zoo\nTo see the animals\n\n{title:I love you mister Bean}\n{subtitle:  Gilles Maire}\n{subtitle: Virtual disk}\n{composer:Gilles Maire}\n{artist:Gilles Maire}\n{lyricist:Gilles Maire}\n{year:2020}\n{columns:2 }\n{tempo:144}\n{time:4/4}}\n\n[Cx2]Hello mister Bean\n[Gx2][How long have you been\n[Cx2]In my memory\n[Gx2]Do you know my trouble \n[Fx2]All my life was hobble\n[G]I was so sa[C]dy \n{start_of_refrain}\n[C]I love you \n[G]Mister Bean\n[F]I love you \n[G]Mister [C] Bean \n{end_of_refrain}\n\nFor you Mister Bean\nI would have peeled beans\nWith a knife\nI would have combed my hair\nI would have dreamed in my chair\nAll my life\n\nBut today Monsieur Beans\nI hadn't planned\nTo be at your funeral\nI had a thousand things to do\nI wanted to go to the zoo\nTo see the animals\n\n{title:Oh mister Bean}\n{subtitle:  Gilles Maire}\n{subtitle: Virtual disk}\n{composer:Gilles Maire}\n{artist:Gilles Maire}\n{lyricist:Gilles Maire}\n{year:2020}\n{columns:2 }\n{tempo:144}\n{time:4/4}}\n\n[Cx2]Hello mister Bean\n[Gx2][How long have you been\n[Cx2]In my memory\n[Gx2]Do you know my trouble \n[Fx2]All my life was hobble\n[G]I was so sa[C]dy \n{start_of_refrain}\n[C]I love you \n[G]Mister Bean\n[F]I love you \n[G]Mister [C] Bean \n{end_of_refrain}\n\nFor you Mister Bean\nI would have peeled beans\nWith a knife\nI would have combed my hair\nI would have dreamed in my chair\nAll my life\n\nBut today Monsieur Beans\nI hadn't planned\nTo be at your funeral\nI had a thousand things to do\nI wanted to go to the zoo\nTo see the animals\n\n\n\n
Creator=Gilles Maire
Lyrics=10
Text=10


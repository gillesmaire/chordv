Source: "{#QtPlugin}\qt5\plugins\platforms\qwindows.dll";DestDir: "{app}\platforms"; Flags: ignoreversion
Source: "{#QtPlugin}\qt5\\plugins\imageformats\qsvg.dll"; DestDir: "{app}\imageformats"; Flags: ignoreversion
Source: "{#SourceDir}\windowsdll\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#SourceDir}\translations\*" ; DestDir: "c:\ProgramData\chordV\"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#SourceDir}\Example\English\demo.chop" ; DestDir: "c:\ProgramData\chordV\English\"; Flags: ignoreversion
Source: "{#SourceDir}\Example\Français\demo.chop" ; DestDir: "c:\ProgramData\chordV\Français"; Flags: ignoreversion
Source: "{#SourceDir}\Docs\User\English\html\*" ; DestDir: "c:\ProgramData\chordV\English\"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#SourceDir}\Docs\User\Français\html\*" ; DestDir: "c:\ProgramData\chordV\Français\"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#SourceDir}\Docs\User\English\pdf\doc.pdf" ; DestDir: "c:\ProgramData\chordV\English\"; Flags: ignoreversion
Source: "{#SourceDir}\Docs\User\Français\pdf\doc.pdf" ; DestDir: "c:\ProgramData\chordV\Français\"; Flags: ignoreversion
